# Supabase → Project Settings → API  (anon key is safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Express API
NEXT_PUBLIC_API_URL=http://localhost:4000

# Mapbox public token (pk.…) — optional. Without it the app draws routes on a built-in SVG canvas instead.
NEXT_PUBLIC_MAPBOX_TOKEN=
